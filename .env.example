# =============================================================================
# PulseDesk (AgentCare) — environment template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- App (product UI name) ---
APP_NAME=PulseDesk
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (SQLite) ---
DATABASE_URL=sqlite:///./data/agentcare.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM (Groq primary, Google-hosted Gemma fallback — same as MediShield/deepagent) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-31b-it
# Pipeline: safety stage-2 + document LLM classify (set false for offline/CI)
USE_LLM=true

# --- LangSmith (optional observability) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agentcare
LANGSMITH_API_KEY=

# --- SMTP (real email; disable in tests) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PulseDesk <your-pulsedesk@gmail.com>
SMTP_TLS=true
SMTP_DISABLED=false

# --- Uploads ---
UPLOAD_DIR=./data/uploads
